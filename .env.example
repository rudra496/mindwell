# ==================================
# MindWell Environment Configuration
# ==================================

# ----------------------------------
# EMAIL SERVICE (Resend)
# ----------------------------------

# Resend API Key for sending emails
# Get your API key from: https://resend.com/api-keys
# Used for session request notifications
RESEND_API_KEY="re_..."

# Contact Email
CONTACT_EMAIL="rudrasarker125@gmail.com"

# Rate Limiting (optional)
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW=86400

# ----------------------------------
# DATABASE CONFIGURATION
# ----------------------------------

# Local Development (SQLite)
# Use this for local development - no external database required
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - Vercel Postgres)
# Vercel automatically provides these when you create a Postgres database
# In Vercel Dashboard → Storage → Create Database → Postgres
# Then connect it to your project
# 
# These will be automatically populated by Vercel:
# DATABASE_URL="postgres://username:password@host:5432/database?sslmode=require"
# POSTGRES_PRISMA_URL="postgres://username:password@host:5432/database?pgbouncer=true&connect_timeout=15"
# POSTGRES_URL_NON_POOLING="postgres://username:password@host:5432/database?sslmode=require"

# Alternative: Supabase PostgreSQL
# Get your connection strings from Supabase Dashboard → Project Settings → Database
# POSTGRES_PRISMA_URL="postgresql://postgres:[password]@[host]:5432/postgres?pgbouncer=true&connection_limit=1"
# POSTGRES_URL_NON_POOLING="postgresql://postgres:[password]@[host]:5432/postgres"
# DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# Alternative: Neon PostgreSQL  
# Get your connection strings from Neon Console → Connection Details
# DATABASE_URL="postgresql://[user]:[password]@[host]/[dbname]?sslmode=require"
# POSTGRES_PRISMA_URL="postgresql://[user]:[password]@[host]/[dbname]?sslmode=require&pgbouncer=true"
# POSTGRES_URL_NON_POOLING="postgresql://[user]:[password]@[host]/[dbname]?sslmode=require"

# ----------------------------------
# OPTIONAL: AI CHATBOT
# ----------------------------------

# OpenAI API for enhanced chatbot responses
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-proj-..."

# ----------------------------------
# APPLICATION SETTINGS
# ----------------------------------

# Application URL
# Local: http://localhost:3000
# Production: Your Vercel deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ----------------------------------
# NOTES FOR DEPLOYMENT
# ----------------------------------
# 
# For Vercel Deployment:
# 1. Don't add these variables to vercel.json
# 2. Set them in Vercel Dashboard → Project Settings → Environment Variables
# 3. Or use Vercel CLI: vercel env add DATABASE_URL
# 4. For Vercel Postgres: connect the database in Vercel dashboard
# 5. Run migrations: vercel env pull && npx prisma migrate deploy
