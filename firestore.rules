rules_version = '2';

// MindWell Firestore Security Rules
//
// The community feature stores posts, replies, and likes in two top-level
// collections: `posts` and `replies`, each with a `likes` subcollection.
//
// Design:
//   - Members-only: you must be signed in (request.auth != null) to read OR
//     write. A mental-health support community's disclosures must NOT be
//     publicly scrapable. (Relax `allow read` to `if true` only if anonymous
//     browsing is intentionally desired.)
//   - Ownership: create requires authorId == your uid; update/delete require
//     the existing doc's authorId (or legacy userId) == your uid, and you may
//     not reassign authorId to someone else on update.
//   - Likes: the like document id is the user's uid; only that user may
//     create/delete their own like.
//
// !!! THIS FILE HAS NO EFFECT UNTIL DEPLOYED !!!
// Deploy with the Firebase CLI (one-time setup: `firebase login` + `firebase init`):
//   firebase deploy --only firestore:rules
// Until then the community collections are governed by the project's current
// (likely permissive) rules — see SECURITY.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
                    && isOwner()
                    && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner();

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && userId == request.auth.uid;
        allow delete: if request.auth != null && userId == request.auth.uid;
      }
    }

    match /replies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
                    && isOwner()
                    && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner();

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && userId == request.auth.uid;
        allow delete: if request.auth != null && userId == request.auth.uid;
      }
    }

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
