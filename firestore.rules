rules_version = '2';

// MindWell Firestore Security Rules
//
// Mirrors the rules deployed in the Firebase console. Design:
//   - Public reads (the community stays browsable without sign-in — preserves
//     the project's existing behavior). For a members-only community, change
//     every `allow read: if true` to `allow read: if isSignedIn()`.
//   - Auth required to write; ownership (authorId or legacy userId) required to
//     edit/delete, null-safe via isOwner().
//   - create must set authorId == your uid; update may not reassign authorId.
//   - Likes are per-user (doc id == uid); only the owner may set/unset theirs.
//
// Deploy any change with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && (resource.data.authorId == request.auth.uid
            || resource.data.userId == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.content is string;

      allow update: if isOwner()
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner();

      match /likes/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /replies/{replyId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isOwner()
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner();

      match /likes/{userId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
