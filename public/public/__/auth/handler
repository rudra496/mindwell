<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Firebase Auth Handler</title>

  <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth-compat.js"></script>

  <script>
    // This page is required for Firebase OAuth redirect handling
    // Firebase reads the OAuth result here and passes it back to the app

    function completeAuth() {
      try {
        // If opened in a popup
        if (window.opener) {
          window.close();
          return;
        }

        // Otherwise redirect back to homepage
        window.location.replace("/");
      } catch (e) {
        console.error("Auth handler error", e);
        window.location.replace("/");
      }
    }

    window.onload = completeAuth;
  </script>
</head>

<body>
</body>
</html>
